<?xml version="1.0"?>
<ruleset name="Lookit SEO Copilot">
    <description>Coding standards for the Lookit SEO Copilot plugin.</description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="8"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Code quality, security, and WordPress conventions (no mandatory doc blocks). -->
    <rule ref="WordPress-Extra"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="lookit-seo-copilot"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="ASY"/>
                <element value="asy"/>
                <element value="BSM"/>
                <element value="bsm"/>
            </property>
        </properties>
    </rule>
    <!-- Existing plugin prefixes are three letters; keep them as-is. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed">
        <severity>0</severity>
    </rule>

    <config name="minimum_wp_version" value="5.9"/>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
